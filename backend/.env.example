# Copy to backend/.env. Manual entry needs Supabase; AI and email are optional.
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Backend/worker only. Never put this in a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Explicitly select account-available models supporting structured output + PDF/image inputs.
OPENAI_EXTRACTION_MODEL=
OPENAI_CHAT_MODEL=
# Select an embeddings model that supports dimensions=1536. See docs/ARCHITECTURE.md.
OPENAI_EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
REDIS_URL=redis://127.0.0.1:6379
MAX_FILE_BYTES=20971520
MAX_PDF_PAGES=40
AI_MAX_OUTPUT_TOKENS=6000
AI_MAX_INPUT_CHARS=80000
AI_DAILY_UNITS=500000
AI_REQUESTS_PER_MINUTE=10
WORKER_CONCURRENCY=2
# Optional Resend transactional adapter. No invitation email is sent by the app.
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=

# Invoice extraction: auto prefers Groq when its key is present.
EXTRACTION_PROVIDER=auto
GROQ_API_KEY=
GROQ_EXTRACTION_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# inline: scan inside the API process; no Redis needed for invoice extraction.
# queue: use Redis plus the separate worker (also needed for reminder delivery).
DOCUMENT_PROCESSING_MODE=queue
